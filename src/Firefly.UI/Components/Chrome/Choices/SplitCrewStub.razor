@using Firefly.Core.State
@using Firefly.UI.Services

<div class="choice-widget">
    <p class="hint">Split-crew stub — comma-separated Team A / non-Leader team ids (remaining form the other team).</p>
    @if (Choice.Options is { Count: > 0 } options)
    {
        <div class="check-list">
            @foreach (var option in options)
            {
                <label class="check">
                    <input type="checkbox" checked="@_selected.Contains(option)"
                           @onchange="e => Toggle(option, (bool)(e.Value ?? false))" />
                    <span>@option</span>
                </label>
            }
        </div>
        <button type="button" class="option-btn" @onclick="SubmitSelected">Submit team</button>
    }
    else
    {
        <label class="field">
            <span>Team A crew ids</span>
            <input @bind="_raw" @bind:event="oninput" placeholder="crew_a, crew_b" />
        </label>
        <button type="button" class="option-btn" @onclick="SubmitRaw">Submit team</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public PendingChoiceView Choice { get; set; } = default!;
    [Parameter] public EventCallback<ChoiceSubmission> SubmitRequested { get; set; }

    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string _raw = "";

    private void Toggle(string option, bool on)
    {
        if (on) _selected.Add(option);
        else _selected.Remove(option);
    }

    private Task SubmitSelected() =>
        SubmitRequested.InvokeAsync(new ChoiceSubmission { Values = _selected.ToList() });

    private Task SubmitRaw()
    {
        var values = _raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        return SubmitRequested.InvokeAsync(new ChoiceSubmission { Values = values });
    }
}
