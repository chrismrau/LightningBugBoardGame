@if (string.IsNullOrEmpty(Src) || _missing)
{
    <div class="portrait placeholder @(Compact ? "compact" : null)" aria-hidden="true"></div>
}
else
{
    <img class="portrait @(Compact ? "compact" : null)"
         src="@Src"
         alt="@Alt"
         loading="lazy"
         @onerror="OnError" />
}

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public bool Compact { get; set; }

    private bool _missing;

    protected override void OnParametersSet()
    {
        _missing = false;
    }

    private void OnError() => _missing = true;
}
