@using Firefly.Core.Actions
@using Firefly.Core.State
@using Firefly.UI.Components.Chrome.Choices
@using Firefly.UI.Services

@if (Pending.HasPending)
{
    <div class="pending-banner" role="status" data-queue="@Pending.QueueKind">
        <strong class="priority">@Pending.PriorityLabel</strong>
        <span class="summary">@Pending.Summary</span>
        @if (Pending.Choice is not null)
        {
            <span class="kind">@Pending.Choice.Kind</span>
        }
        else if (Pending.Misbehave?.HasFaceUp == true)
        {
            <span class="kind">@Pending.Misbehave.CardId</span>
        }
        else if (Pending.Nav?.HasFaceUp == true)
        {
            <span class="kind">@Pending.Nav.CardId</span>
        }
    </div>

    @if (Pending.Choice is { } choice)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="pending-choice-title">
            <div class="pending-modal">
                <header class="pending-modal-header">
                    <h2 id="pending-choice-title">Pending choice</h2>
                    <span class="kind-chip">@choice.Kind</span>
                </header>
                <p class="prompt">@(choice.Prompt ?? "Choose an option to continue.")</p>
                @if (!string.IsNullOrEmpty(choice.ContextId))
                {
                    <p class="context">Context: <code>@choice.ContextId</code></p>
                }

                @switch (choice.WidgetMode)
                {
                    case ChoiceWidgetMode.AcceptDecline:
                        <AcceptDeclineWidget Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.Amount:
                        <AmountWidget Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.SingleValue:
                        <SingleValueWidget Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.MultiValue:
                        <MultiValueWidget Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.GoodsMix:
                        <GoodsMixStub Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.SplitCrew:
                        <SplitCrewStub Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                    case ChoiceWidgetMode.Options:
                    case ChoiceWidgetMode.Generic:
                    default:
                        <GenericChoiceWidget Choice="choice" SubmitRequested="OnSubmit" />
                        break;
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
    else if (Pending.QueueKind == PendingQueueKind.Nav && Pending.Nav is { } nav)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="nav-title">
            <div class="pending-modal nav-modal">
                <header class="pending-modal-header">
                    <h2 id="nav-title">Nav</h2>
                    <span class="kind-chip">@(nav.Region ?? "queued")</span>
                </header>

                @if (nav.NeedsReveal)
                {
                    <p class="prompt">
                        Full Burn queued <strong>@nav.QueuedCount</strong> Nav draw@(nav.QueuedCount == 1 ? "" : "s").
                        Reveal the next card.
                    </p>
                    <button type="button" class="nav-btn primary" @onclick="OnRevealNav">Reveal Nav card</button>
                }
                else if (nav.NeedsResolve)
                {
                    <div class="nav-card">
                        <p class="nav-type">@nav.CardType</p>
                        <h3 class="nav-name">@nav.CardName</h3>
                        <p class="nav-meta">
                            <code>@nav.CardId</code>
                            · @nav.SectorId
                            @if (nav.QueuedCount > 0)
                            {
                                <span>· @nav.QueuedCount more queued</span>
                            }
                        </p>
                    </div>

                    <div class="nav-options" role="list">
                        @foreach (var opt in nav.Options)
                        {
                            <button type="button"
                                    class="nav-option"
                                    role="listitem"
                                    @onclick="() => OnResolveNav(opt.Index)">
                                <span class="opt-label">@opt.Label</span>
                                <span class="opt-outcome">@opt.Outcome</span>
                                <span class="opt-details">@opt.Details</span>
                            </button>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
    else if (Pending.QueueKind == PendingQueueKind.Misbehave && Pending.Misbehave is { } mb)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="misbehave-title">
            <div class="pending-modal nav-modal misbehave-modal">
                <header class="pending-modal-header">
                    <h2 id="misbehave-title">Misbehave</h2>
                    <span class="kind-chip">
                        @(mb.IsGoalWork ? $"Goal {mb.GoalNumber}" : mb.Site?.ToString() ?? "Work")
                        · @mb.Remaining left
                    </span>
                </header>

                @if (mb.NeedsReveal)
                {
                    <p class="prompt">
                        Draw the next Misbehave card
                        @if (!string.IsNullOrEmpty(mb.JobId))
                        {
                            <text> for <code>@mb.JobId</code></text>
                        }
                        .
                    </p>
                    <button type="button" class="nav-btn primary" @onclick="OnRevealMisbehave">Reveal Misbehave</button>
                }
                else if (mb.NeedsResolve)
                {
                    <div class="nav-card misbehave-card">
                        <p class="nav-type">Misbehave@(string.IsNullOrEmpty(mb.Suit) ? "" : $" · {mb.Suit}")</p>
                        <h3 class="nav-name">@mb.CardName</h3>
                        <p class="nav-meta">
                            <code>@mb.CardId</code>
                            @if (!string.IsNullOrEmpty(mb.Keyword))
                            {
                                <span>· @mb.Keyword</span>
                            }
                            @if (!string.IsNullOrEmpty(mb.Other))
                            {
                                <span>· @mb.Other</span>
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(mb.Ace))
                        {
                            <p class="ace-hint">Ace: @mb.Ace — auto-succeed when you have this keyword (GF9 p.14).</p>
                        }
                    </div>

                    <div class="nav-options" role="list">
                        @foreach (var opt in mb.Options)
                        {
                            <button type="button"
                                    class="nav-option"
                                    role="listitem"
                                    @onclick="() => OnResolveMisbehaveOption(opt.Index)">
                                <span class="opt-label">@(string.IsNullOrWhiteSpace(opt.Name) ? $"Option {opt.Index + 1}" : opt.Name)</span>
                                <span class="opt-details">@opt.Details</span>
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(mb.Ace))
                    {
                        <button type="button" class="nav-btn ace" @onclick="OnResolveMisbehaveAce">
                            Use Ace (@mb.Ace)
                        </button>
                    }
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
    else if (Pending.QueueKind == PendingQueueKind.GoalWork)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="goal-work-title">
            <div class="pending-modal nav-modal">
                <header class="pending-modal-header">
                    <h2 id="goal-work-title">Goal Work</h2>
                    <span class="kind-chip">continue</span>
                </header>
                <p class="prompt">@Pending.Summary — continue boarding / skill / evade via the kernel.</p>
                <button type="button" class="nav-btn primary" @onclick="OnContinueGoalWork">Continue Goal Work</button>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
    else if (Pending.QueueKind == PendingQueueKind.Alerts && Pending.AlertTokens is { } alerts)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="alert-tokens-title">
            <div class="pending-modal nav-modal">
                <header class="pending-modal-header">
                    <h2 id="alert-tokens-title">Alert Tokens</h2>
                    <span class="kind-chip">@alerts.SectorCount sector(s)</span>
                </header>
                <p class="prompt">@alerts.Prompt</p>
                @if (!string.IsNullOrEmpty(alerts.FirstSectorId))
                {
                    <p class="context">Next: <code>@alerts.FirstSectorId</code></p>
                }
                <button type="button" class="nav-btn primary" @onclick="OnResolveAlertTokens">Resolve next Alert Token sector</button>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
    else if (Pending.QueueKind == PendingQueueKind.Encounter && Pending.Encounter is { } enc)
    {
        <div class="pending-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="encounter-title">
            <div class="pending-modal nav-modal">
                <header class="pending-modal-header">
                    <h2 id="encounter-title">Encounter</h2>
                    <span class="kind-chip">@enc.TokenKind</span>
                </header>
                <p class="prompt">@enc.Prompt</p>
                @if (!string.IsNullOrEmpty(enc.SectorId))
                {
                    <p class="context">Sector: <code>@enc.SectorId</code></p>
                }
                <div class="nav-options" role="list">
                    @foreach (var opt in enc.Options)
                    {
                        <button type="button"
                                class="nav-option"
                                role="listitem"
                                @onclick="() => OnResolveEncounter(opt.Id)">
                            <span class="opt-label">@opt.Label</span>
                            @if (!string.IsNullOrEmpty(opt.Detail))
                            {
                                <span class="opt-details">@opt.Detail</span>
                            }
                        </button>
                    }
                </div>
                @if (enc.Options.Count == 0)
                {
                    <p class="prompt">No resolve options — document as exotic gap.</p>
                }
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="error" role="alert">@_error</p>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public PendingHostView Pending { get; set; } = default!;
    [Parameter] public EventCallback<ChoiceSubmission> ChoiceSubmitted { get; set; }
    [Parameter] public EventCallback RevealNavRequested { get; set; }
    [Parameter] public EventCallback<int> ResolveNavOptionRequested { get; set; }
    [Parameter] public EventCallback RevealMisbehaveRequested { get; set; }
    [Parameter] public EventCallback<MisbehaveChoice> ResolveMisbehaveRequested { get; set; }
    [Parameter] public EventCallback ContinueGoalWorkRequested { get; set; }
    [Parameter] public EventCallback ResolveAlertTokensRequested { get; set; }
    [Parameter] public EventCallback<string> ResolveEncounterRequested { get; set; }

    private string? _error;

    private async Task OnSubmit(ChoiceSubmission submission)
    {
        _error = null;
        await ChoiceSubmitted.InvokeAsync(submission);
    }

    private async Task OnRevealNav()
    {
        _error = null;
        await RevealNavRequested.InvokeAsync();
    }

    private async Task OnResolveNav(int optionIndex)
    {
        _error = null;
        await ResolveNavOptionRequested.InvokeAsync(optionIndex);
    }

    private async Task OnRevealMisbehave()
    {
        _error = null;
        await RevealMisbehaveRequested.InvokeAsync();
    }

    private async Task OnResolveMisbehaveOption(int optionIndex)
    {
        _error = null;
        await ResolveMisbehaveRequested.InvokeAsync(new MisbehaveChoice { OptionIndex = optionIndex });
    }

    private async Task OnResolveMisbehaveAce()
    {
        _error = null;
        await ResolveMisbehaveRequested.InvokeAsync(new MisbehaveChoice { UseAce = true });
    }

    private async Task OnContinueGoalWork()
    {
        _error = null;
        await ContinueGoalWorkRequested.InvokeAsync();
    }

    private async Task OnResolveAlertTokens()
    {
        _error = null;
        await ResolveAlertTokensRequested.InvokeAsync();
    }

    private async Task OnResolveEncounter(string optionId)
    {
        _error = null;
        await ResolveEncounterRequested.InvokeAsync(optionId);
    }

    /// <summary>Parent can push a kernel rejection message after a failed submit.</summary>
    public void SetError(string? error)
    {
        _error = error;
        StateHasChanged();
    }
}
