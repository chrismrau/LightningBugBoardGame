@page "/"
@rendermode InteractiveServer
@using Firefly.Core.Map
@using Firefly.Core.State
@using Firefly.UI.Components.Chrome
@using Firefly.UI.Components.Map
@using Firefly.UI.Services
@inject IGameSession Session
@inject RepoPaths Paths
@implements IDisposable

<PageTitle>Lightning Bug — Play</PageTitle>

<div class="play-shell">
    <header class="play-header">
        <div class="brand">
            <span class="mark">Lightning Bug</span>
            <span class="mode">Hotseat · P2 turn chrome</span>
        </div>
        <ScenarioChip ScenarioCardId="@_snap.ScenarioCardId"
                      UseBlueSun="@_snap.UseBlueSun"
                      UseBountyDeck="@_snap.UseBountyDeck"
                      UseOperativesCorvette="@_snap.UseOperativesCorvette"
                      RestartRequested="OnRestart" />
    </header>

    <StatusStrip Snapshot="_snap" />
    <PendingHost @ref="_pendingHost" Pending="_snap.Pending" ChoiceSubmitted="OnChoiceSubmitted" />

    <div class="play-body">
        <VerseMap SelectedSectorId="_snap.SelectedSectorId"
                  Ships="_snap.ShipTokens"
                  Markers="_snap.Markers"
                  BoardArtAvailable="_boardArt"
                  SectorSelected="OnSectorSelected" />
        <InspectPanel Info="_snap.Inspect" />
    </div>

    <ActionBar Snapshot="_snap"
               EndTurnRequested="OnEndTurn"
               TurnActionRequested="OnTurnAction"
               ShoreLeaveRequested="OnShoreLeave"
               BetterOfferRequested="OnBetterOffer" />

    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="play-toast" role="status">@_toast</div>
    }
</div>

@code {
    private PlayViewSnapshot _snap = default!;
    private bool _boardArt;
    private SectorMap _map = default!;
    private PendingHost? _pendingHost;
    private string? _toast;

    protected override void OnInitialized()
    {
        _map = Session.Game.Map;
        _boardArt = Paths.BoardArtAvailable;
        Refresh();
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        _snap = PlayViewSnapshot.From(Session, _map);
    }

    private void OnSectorSelected(string sectorId)
    {
        var next = string.Equals(Session.SelectedSectorId, sectorId, StringComparison.OrdinalIgnoreCase)
            ? null
            : sectorId;
        Session.SelectSector(next);
    }

    private void OnEndTurn() => Session.EndTurn();

    private void OnTurnAction(TurnAction action)
    {
        // P3 Fly / later action surfaces plug in here. Legality already gated by CanTakeAction.
        _toast = $"{action} — action UI arrives in a later phase.";
    }

    private void OnShoreLeave()
    {
        _toast = "Shore Leave — Buy-action UI in P6.";
    }

    private void OnBetterOffer()
    {
        _toast = "A Better Offer — poach UI later (not an action).";
    }

    private void OnChoiceSubmitted(ChoiceSubmission submission)
    {
        if (Session.TrySubmitChoice(submission, out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }

        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnRestart((string ScenarioId, bool BlueSun, bool Bounty, bool Corvette) args)
    {
        Session.StartNew(args.ScenarioId, args.BlueSun, args.Bounty, args.Corvette);
        _map = Session.Game.Map;
        _toast = null;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
