@page "/"
@rendermode InteractiveServer
@using Firefly.Core.Actions
@using Firefly.Core.Map
@using Firefly.Core.State
@using Firefly.UI.Components.Chrome
@using Firefly.UI.Components.Map
@using Firefly.UI.Services
@inject IGameSession Session
@inject RepoPaths Paths
@implements IDisposable

<PageTitle>Lightning Bug — Play</PageTitle>

<div class="play-shell">
    <header class="play-header">
        <div class="brand">
            <span class="mark">Lightning Bug</span>
            <span class="mode">Hotseat · P9 Expansions</span>
        </div>
        <ScenarioChip ScenarioCardId="@_snap.ScenarioCardId"
                      UseBlueSun="@_snap.UseBlueSun"
                      UseBountyDeck="@_snap.UseBountyDeck"
                      UseOperativesCorvette="@_snap.UseOperativesCorvette"
                      SeatCount="@_snap.SeatCount"
                      RestartRequested="OnRestart" />
    </header>

    <StatusStrip Snapshot="_snap" ShipSheetRequested="OpenShipSheet" />
    <ExpansionChrome Chrome="_snap.Expansions" />
    <PendingHost @ref="_pendingHost"
                 Pending="_snap.Pending"
                 ChoiceSubmitted="OnChoiceSubmitted"
                 RevealNavRequested="OnRevealNav"
                 ResolveNavOptionRequested="OnResolveNavOption"
                 RevealMisbehaveRequested="OnRevealMisbehave"
                 ResolveMisbehaveRequested="OnResolveMisbehave"
                 ContinueGoalWorkRequested="OnContinueGoalWork"
                 ResolveAlertTokensRequested="OnResolveAlertTokens"
                 ResolveEncounterRequested="OnResolveEncounter" />
    <FlyChrome Chrome="_flyChrome"
               KindRequested="OnFlyKind"
               CancelRequested="OnFlyCancel"
               ConfirmRequested="OnFullBurnConfirm"
               ClearPathRequested="OnFullBurnClearPath" />
    <DealChrome Chrome="_dealChrome"
                ContactChanged="OnDealContactChanged"
                CancelRequested="OnEconomyCancel"
                PickConfirmed="OnDealPick"
                KeepConfirmed="OnDealKeepSubmission"
                BrowseDiscardRequested="OnDealBrowseDiscard" />
    <BuyChrome Chrome="_buyChrome"
               CancelRequested="OnEconomyCancel"
               ConfirmRequested="OnBuyConfirm"
               BrowseDiscardRequested="OnBuyBrowseDiscard" />
    <BetterOfferChrome Chrome="_betterOfferChrome"
                       CancelRequested="OnEconomyCancel"
                       PoachRequested="OnPoach" />
    <WorkChrome Chrome="_workChrome"
                CancelRequested="OnWorkCancel"
                AttemptRequested="OnWorkAttempt" />

    <div class="play-body">
        <div class="map-host">
            <ShipSheet Sheet="_snap.ShipSheet"
                       IsOpen="_shipSheetOpen"
                       IsOpenChanged="OnShipSheetOpenChanged"
                       ShowJobHand="true"
                       Edge="ShipSheetEdge.Left" />
            <RivalSheets Rivals="_snap.RivalSheets"
                         OpenPlayerId="_openRivalId"
                         OpenPlayerIdChanged="OnRivalOpenChanged" />
            <DiscardBrowser View="_snap.Discards"
                            IsOpen="_discardOpen"
                            IsOpenChanged="OnDiscardOpenChanged"
                            FocusTarget="_discardFocus"
                            FocusTargetConsumed="OnDiscardFocusConsumed" />
            <VerseMap SelectedSectorId="_snap.SelectedSectorId"
                      Ships="_snap.ShipTokens"
                      Markers="_snap.Markers"
                      LegalSectorIds="_flyChrome.LegalSectorIds"
                      PathSectorIds="_flyChrome.PathSectorIds"
                      PathDestinationId="_flyChrome.PathDestinationId"
                      BoardArtAvailable="_boardArt"
                      SectorSelected="OnSectorSelected" />
        </div>
        <InspectPanel Info="_snap.Inspect" />
    </div>

    <ActionBar Snapshot="_snap"
               EndTurnRequested="OnEndTurn"
               TurnActionRequested="OnTurnAction"
               ShoreLeaveRequested="OnShoreLeave"
               BetterOfferRequested="OnBetterOffer" />

    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="play-toast" role="status">@_toast</div>
    }
</div>

@code {
    private PlayViewSnapshot _snap = default!;
    private FlyChromeView _flyChrome = new(
        FlyUiMode.None,
        false,
        null,
        0,
        1,
        0,
        true,
        Array.Empty<string>(),
        Array.Empty<string>(),
        null,
        false);
    private DealChromeView _dealChrome = IdleDealChrome();
    private BuyChromeView _buyChrome = IdleBuyChrome();
    private BetterOfferChromeView _betterOfferChrome = IdleBetterOfferChrome();
    private WorkChromeView _workChrome = IdleWorkChrome();

    private bool _boardArt;
    private SectorMap _map = default!;
    private PendingHost? _pendingHost;
    private string? _toast;
    private FlyUiMode _flyMode = FlyUiMode.None;
    private IReadOnlyList<string> _burnPath = Array.Empty<string>();
    private EconomyUiMode _economyMode = EconomyUiMode.None;
    private WorkUiMode _workMode = WorkUiMode.None;
    private string? _dealContact;
    private bool _shipSheetOpen;
    private bool _discardOpen;
    private string? _discardFocus;
    private string? _openRivalId;

    protected override void OnInitialized()
    {
        _map = Session.Game.Map;
        _boardArt = Paths.BoardArtAvailable;
        Refresh();
        Session.Changed += OnSessionChanged;
    }

    private static DealChromeView IdleDealChrome() =>
        new(
            EconomyUiMode.None,
            null,
            Array.Empty<DealContactOption>(),
            Array.Empty<DealDiscardJobOption>(),
            0,
            2,
            0,
            3,
            0,
            0,
            0,
            0,
            0,
            false,
            null,
            null,
            false,
            Array.Empty<DealConsideredJobView>(),
            null);

    private static BuyChromeView IdleBuyChrome() =>
        new(
            EconomyUiMode.None,
            null,
            false,
            null,
            0,
            0,
            0,
            BuyAction.FuelPrice,
            BuyAction.PartsPrice,
            2,
            Array.Empty<BuyFaceUpCardView>(),
            null);

    private static BetterOfferChromeView IdleBetterOfferChrome() =>
        new(EconomyUiMode.None, Array.Empty<BetterOfferTargetView>(), null);

    private static WorkChromeView IdleWorkChrome() =>
        new(WorkUiMode.None, Array.Empty<WorkAttemptOption>(), null);

    private void OnSessionChanged()
    {
        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        _snap = PlayViewSnapshot.From(Session, _map);
        // Drop Fly chrome if Fly is no longer legal (pending Nav / action consumed / EndTurn).
        if (_flyMode != FlyUiMode.None
            && (_snap.HasPendingEvents || !Session.Game.CanTakeAction(TurnAction.Fly, out _)))
        {
            _flyMode = FlyUiMode.None;
            _burnPath = Array.Empty<string>();
        }
        _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);

        if (_economyMode is EconomyUiMode.DealPick or EconomyUiMode.DealConsider)
        {
            if (_snap.HasPendingEvents || !Session.Game.CanTakeAction(TurnAction.Deal, out _))
            {
                // Keep consider staging visible while PendingChoice (e.g. DealSellParts) is up;
                // otherwise collapse when Deal is spent / blocked.
                if (Session.DealConsideredJobs == null
                    && Session.Game.PendingChoice?.Kind != PendingChoiceKinds.DealSellParts)
                {
                    _economyMode = EconomyUiMode.None;
                    _dealContact = null;
                }
            }
        }
        else if (_economyMode == EconomyUiMode.BuyPick)
        {
            if (_snap.HasPendingEvents || !Session.Game.CanTakeAction(TurnAction.Buy, out _))
                _economyMode = EconomyUiMode.None;
        }
        else if (_economyMode == EconomyUiMode.BetterOfferPick)
        {
            if (_snap.HasPendingEvents)
                _economyMode = EconomyUiMode.None;
        }

        if (_workMode == WorkUiMode.Pick
            && (_snap.HasPendingEvents || !Session.Game.CanTakeAction(TurnAction.Work, out _)))
        {
            // Keep chrome collapsed once Work suspends into Misbehave / PendingChoice.
            _workMode = WorkUiMode.None;
        }

        RebuildEconomyChrome();
        RebuildWorkChrome();
    }

    private void RebuildEconomyChrome()
    {
        if (_economyMode is EconomyUiMode.DealPick or EconomyUiMode.DealConsider)
        {
            IReadOnlyList<DealConsideredJobView>? considered = null;
            var staged = Session.DealConsideredJobs;
            if (staged != null)
            {
                considered = staged
                    .Select(j => new DealConsideredJobView(
                        j.Id,
                        j.Name,
                        j.Legal,
                        j.Immoral,
                        j.PayBase != null ? $"${j.PayBase:N0}" : j.PayRaw))
                    .ToList();
            }
            _dealChrome = EconomyChromeBuilder.BuildDeal(Session.Game, _dealContact, considered);
            _buyChrome = _buyChrome with { Mode = EconomyUiMode.None };
            _betterOfferChrome = _betterOfferChrome with { Mode = EconomyUiMode.None };
        }
        else if (_economyMode == EconomyUiMode.BuyPick)
        {
            _buyChrome = EconomyChromeBuilder.BuildBuy(Session.Game);
            _dealChrome = _dealChrome with { Mode = EconomyUiMode.None };
            _betterOfferChrome = _betterOfferChrome with { Mode = EconomyUiMode.None };
        }
        else if (_economyMode == EconomyUiMode.BetterOfferPick)
        {
            _betterOfferChrome = EconomyChromeBuilder.BuildBetterOffer(Session.Game);
            _dealChrome = _dealChrome with { Mode = EconomyUiMode.None };
            _buyChrome = _buyChrome with { Mode = EconomyUiMode.None };
        }
        else
        {
            _dealChrome = _dealChrome with { Mode = EconomyUiMode.None };
            _buyChrome = _buyChrome with { Mode = EconomyUiMode.None };
            _betterOfferChrome = _betterOfferChrome with { Mode = EconomyUiMode.None };
        }
    }

    private void RebuildWorkChrome()
    {
        if (_workMode == WorkUiMode.Pick)
            _workChrome = WorkChromeBuilder.Build(Session.Game);
        else
            _workChrome = IdleWorkChrome();
    }

    private void OnSectorSelected(string sectorId)
    {
        if (_flyMode == FlyUiMode.Mosey)
        {
            if (!_flyChrome.LegalSectorIds.Contains(sectorId, StringComparer.OrdinalIgnoreCase))
            {
                _toast = "Not a legal Mosey destination.";
                return;
            }
            if (Session.TryMosey(sectorId, out var error))
            {
                _flyMode = FlyUiMode.None;
                _burnPath = Array.Empty<string>();
                _toast = $"Moseyed to {sectorId}.";
                return;
            }
            _toast = error;
            _pendingHost?.SetError(error);
            return;
        }

        if (_flyMode == FlyUiMode.FullBurn)
        {
            if (!_flyChrome.LegalSectorIds.Contains(sectorId, StringComparer.OrdinalIgnoreCase))
            {
                _toast = "Not within Full Burn drive range.";
                return;
            }
            var from = Session.Game.CurrentPlayer.SectorId;
            var path = Session.Movement.Pathfinder.ShortestPath(from, sectorId);
            if (path == null || path.Count < 2)
            {
                _toast = "No path to that sector.";
                return;
            }
            _burnPath = path;
            _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);
            Session.SelectSector(sectorId);
            return;
        }

        var next = string.Equals(Session.SelectedSectorId, sectorId, StringComparison.OrdinalIgnoreCase)
            ? null
            : sectorId;
        Session.SelectSector(next);
    }

    private void OnEndTurn()
    {
        ClearFlyUi();
        ClearEconomyUi(cancelConsider: true);
        ClearWorkUi();
        Session.EndTurn();
        _toast = null;
    }

    private void OnTurnAction(TurnAction action)
    {
        if (action == TurnAction.Fly)
        {
            ClearEconomyUi(cancelConsider: true);
            ClearWorkUi();
            _flyMode = FlyUiMode.PickKind;
            _burnPath = Array.Empty<string>();
            _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);
            _toast = null;
            return;
        }

        if (action == TurnAction.Deal)
        {
            ClearFlyUi();
            ClearWorkUi();
            _economyMode = EconomyUiMode.DealPick;
            _dealContact = null;
            RebuildEconomyChrome();
            _dealContact = _dealChrome.SelectedContact;
            _toast = null;
            return;
        }

        if (action == TurnAction.Buy)
        {
            ClearFlyUi();
            ClearWorkUi();
            _economyMode = EconomyUiMode.BuyPick;
            RebuildEconomyChrome();
            if (_buyChrome.Planet != null)
                OpenDiscardBrowser(DiscardBrowseTargets.Supply(_buyChrome.Planet));
            _toast = null;
            return;
        }

        if (action == TurnAction.Work)
        {
            ClearFlyUi();
            ClearEconomyUi(cancelConsider: true);
            _workMode = WorkUiMode.Pick;
            RebuildWorkChrome();
            _toast = null;
            return;
        }

        _toast = $"{action} — action UI arrives in a later phase.";
    }

    private void OnFlyKind(FlyUiMode kind)
    {
        if (kind == FlyUiMode.FullBurn && !_flyChrome.CanFullBurn)
        {
            _toast = _flyChrome.FullBurnBlockReason;
            return;
        }
        _flyMode = kind;
        _burnPath = Array.Empty<string>();
        _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);
        _toast = null;
    }

    private void OnFlyCancel()
    {
        ClearFlyUi();
        _toast = null;
    }

    private void OnFullBurnClearPath()
    {
        _burnPath = Array.Empty<string>();
        _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);
    }

    private void OnFullBurnConfirm()
    {
        if (_burnPath.Count < 2)
        {
            _toast = "Pick a Full Burn destination first.";
            return;
        }
        if (Session.TryFullBurn(_burnPath, out var error))
        {
            ClearFlyUi();
            _toast = "Full Burn complete — resolve Nav if queued.";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
    }

    private void OnRevealNav()
    {
        if (Session.TryDrawNav(out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnResolveNavOption(int optionIndex)
    {
        if (Session.TryResolveNavOption(optionIndex, out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnShoreLeave()
    {
        ClearFlyUi();
        ClearEconomyUi(cancelConsider: true);
        ClearWorkUi();
        if (Session.TryShoreLeave(out var error))
        {
            _toast = "Shore Leave complete (Buy action).";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
    }

    private void OnBetterOffer()
    {
        ClearFlyUi();
        ClearWorkUi();
        _economyMode = EconomyUiMode.BetterOfferPick;
        RebuildEconomyChrome();
        _toast = null;
    }

    private void OnRevealMisbehave()
    {
        if (Session.TryDrawMisbehave(out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnResolveMisbehave(MisbehaveChoice choice)
    {
        if (Session.TryResolveMisbehave(choice, out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnContinueGoalWork()
    {
        if (Session.TryContinueGoalWork(out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnWorkCancel()
    {
        ClearWorkUi();
        _toast = null;
    }

    private void OnWorkAttempt(WorkAttemptOption attempt)
    {
        bool ok;
        string? error;
        switch (attempt.Kind)
        {
            case WorkAttemptKind.Job:
                ok = Session.TryWork(attempt.Id, out error);
                break;
            case WorkAttemptKind.MakeWork:
                ok = Session.TryMakeWork(out error);
                break;
            case WorkAttemptKind.Datascope:
                ok = Session.TryDatascope(out error);
                break;
            case WorkAttemptKind.Goal when attempt.GoalNumber is int goal:
                ok = Session.TryWorkGoal(goal, out error);
                break;
            case WorkAttemptKind.BountyConfront when attempt.RivalId is { } rival
                && attempt.CrewId is { } crew:
                ok = Session.TryBountyConfront(attempt.Id, rival, crew, out error);
                break;
            case WorkAttemptKind.BountyLone when attempt.CrewId is { } loneCrew:
                ok = Session.TryBountyLone(attempt.Id, loneCrew, out error);
                break;
            case WorkAttemptKind.BountyBetray when attempt.CrewId is { } betrayCrew:
                ok = Session.TryBountyBetray(attempt.Id, betrayCrew, out error);
                break;
            case WorkAttemptKind.BountyDeliver:
                ok = Session.TryBountyDeliver(attempt.Id, out error);
                break;
            case WorkAttemptKind.BountyJump when attempt.RivalId is { } fromRival:
                ok = Session.TryBountyJump(attempt.Id, fromRival, attempt.Rescue, out error);
                break;
            default:
                _toast = "Unknown Work attempt.";
                return;
        }

        if (ok)
        {
            ClearWorkUi();
            if (Session.Game.PendingMisbehave != null)
                _toast = "Work started — resolve Misbehave.";
            else if (Session.Game.PendingGoalWork != null)
                _toast = "Goal Work started — continue in PendingHost.";
            else if (Session.Game.PendingChoice != null)
                _toast = null; // PendingHost takes over
            else
                _toast = $"{attempt.Title} complete.";
            return;
        }

        _toast = error;
        _pendingHost?.SetError(error);
        RebuildWorkChrome();
    }

    private void OnResolveAlertTokens()
    {
        if (Session.TryResolveAlertTokens(out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnResolveEncounter(string optionId)
    {
        if (Session.TryResolveEncounter(optionId, out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }
        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnDealContactChanged(string contactName)
    {
        _dealContact = contactName;
        RebuildEconomyChrome();
    }

    private void OnDealPick(DealPickSubmission pick)
    {
        var request = new DealRequest
        {
            ContactName = pick.ContactName,
            ConsiderCount = pick.ConsiderCount,
            SellContraband = pick.SellContraband,
            SellCargo = pick.SellCargo,
            ClearWarrants = pick.ClearWarrants
        };
        foreach (var id in pick.TakeFromDiscard)
            request.TakeFromDiscard.Add(id);

        if (pick.ConsiderCount > 0)
        {
            if (Session.TryBeginDealConsider(request, out var beginError))
            {
                _economyMode = EconomyUiMode.DealConsider;
                _dealContact = pick.ContactName;
                RebuildEconomyChrome();
                _toast = null;
                return;
            }
            _toast = beginError;
            _pendingHost?.SetError(beginError);
            return;
        }

        if (Session.TryDeal(request, out var error))
        {
            if (Session.Game.PendingChoice != null)
            {
                // e.g. DealSellParts — PendingHost takes over; leave Deal chrome collapsed.
                ClearEconomyUi(cancelConsider: false);
                _toast = null;
                return;
            }
            ClearEconomyUi(cancelConsider: false);
            _toast = $"Dealt with {pick.ContactName}.";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
        RebuildEconomyChrome();
    }

    private void OnDealKeepSubmission(DealKeepSubmission keep)
    {
        if (Session.TryFinishDealConsider(keep.KeepJobIds, out var error))
        {
            if (Session.Game.PendingChoice != null)
            {
                ClearEconomyUi(cancelConsider: false);
                _toast = null;
                return;
            }
            ClearEconomyUi(cancelConsider: false);
            _toast = keep.KeepJobIds.Count == 0
                ? "Deal complete — no jobs kept."
                : $"Deal complete — kept {keep.KeepJobIds.Count} job(s).";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
        RebuildEconomyChrome();
    }

    private void OnDealBrowseDiscard()
    {
        var contact = _dealChrome.SelectedContact;
        if (!string.IsNullOrEmpty(contact))
            OpenDiscardBrowser(DiscardBrowseTargets.Contact(contact));
        else
            OpenDiscardBrowser();
    }

    private void OnBuyConfirm(BuyPickSubmission pick)
    {
        var request = new BuyRequest
        {
            Fuel = pick.Fuel,
            Parts = pick.Parts
        };
        foreach (var id in pick.SupplyCardIds)
            request.SupplyCardIds.Add(id);

        if (Session.TryBuy(request, out var error))
        {
            ClearEconomyUi(cancelConsider: false);
            _toast = $"Buy at {_buyChrome.Planet} complete.";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
    }

    private void OnBuyBrowseDiscard()
    {
        if (!string.IsNullOrEmpty(_buyChrome.Planet))
            OpenDiscardBrowser(DiscardBrowseTargets.Supply(_buyChrome.Planet));
        else
            OpenDiscardBrowser();
    }

    private void OnPoach(BetterOfferTargetView target)
    {
        if (Session.TryPoach(target.RivalPlayerId, target.CrewId, out var error))
        {
            ClearEconomyUi(cancelConsider: false);
            _toast = $"Hired {target.CrewName} for ${target.Cost} (A Better Offer).";
            return;
        }
        _toast = error;
        _pendingHost?.SetError(error);
        RebuildEconomyChrome();
    }

    private void OnEconomyCancel()
    {
        ClearEconomyUi(cancelConsider: true);
        _toast = null;
    }

    private void OnChoiceSubmitted(ChoiceSubmission submission)
    {
        if (Session.TrySubmitChoice(submission, out var error))
        {
            _toast = null;
            _pendingHost?.SetError(null);
            return;
        }

        _pendingHost?.SetError(error);
        _toast = error;
    }

    private void OnRestart((string ScenarioId, bool BlueSun, bool Bounty, bool Corvette, int SeatCount) args)
    {
        ClearFlyUi();
        ClearEconomyUi(cancelConsider: true);
        ClearWorkUi();
        _shipSheetOpen = false;
        _discardOpen = false;
        _discardFocus = null;
        _openRivalId = null;
        Session.StartNew(args.ScenarioId, args.BlueSun, args.Bounty, args.Corvette, args.SeatCount);
        _map = Session.Game.Map;
        _toast = null;
    }

    private void OpenShipSheet() => _shipSheetOpen = true;

    private void OnShipSheetOpenChanged(bool open) => _shipSheetOpen = open;

    private void OnRivalOpenChanged(string? playerId)
    {
        _openRivalId = playerId;
        // Right-edge polish: rival drawer and discards are mutually exclusive.
        if (!string.IsNullOrEmpty(playerId))
        {
            _discardOpen = false;
            _discardFocus = null;
        }
    }

    /// <summary>
    /// Opens the discard browser, optionally focused on a <see cref="DiscardBrowseTargets"/> key.
    /// </summary>
    private void OpenDiscardBrowser(string? focusTarget = null)
    {
        _openRivalId = null;
        _discardFocus = focusTarget;
        _discardOpen = true;
    }

    private void OnDiscardOpenChanged(bool open)
    {
        _discardOpen = open;
        if (open)
            _openRivalId = null;
        if (!open)
            _discardFocus = null;
    }

    private void OnDiscardFocusConsumed() => _discardFocus = null;

    private void ClearFlyUi()
    {
        _flyMode = FlyUiMode.None;
        _burnPath = Array.Empty<string>();
        _flyChrome = FlyLegalBuilder.Build(Session.Game, Session.Movement, _flyMode, _burnPath);
    }

    private void ClearEconomyUi(bool cancelConsider)
    {
        if (cancelConsider && Session.DealConsideredJobs != null)
            Session.CancelDealConsider();
        _economyMode = EconomyUiMode.None;
        _dealContact = null;
        RebuildEconomyChrome();
    }

    private void ClearWorkUi()
    {
        _workMode = WorkUiMode.None;
        RebuildWorkChrome();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
