@using System.Globalization
@using Firefly.UI.Services
@inject SectorLayoutService LayoutService
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="map-viewport" @ref="_viewport" title="Scroll to zoom · drag empty space / middle-mouse / Space+drag to pan · 0 to fit">
    <div class="map-stage" @ref="_stage">
        @if (_boardAvailable)
        {
            <img class="map-stage-bg"
                 src="/board/GameBoardMarkup.png"
                 width="@SectorLayout.ImageWidth"
                 height="@SectorLayout.ImageHeight"
                 style="left: @(SectorLayout.ImageOffsetX)px; top: @(SectorLayout.ImageOffsetY)px;"
                 alt="Firefly game board"
                 draggable="false" />
        }
        else
        {
            <div class="map-stage-bg map-stage-fallback"
                 style="left: @(SectorLayout.ImageOffsetX)px; top: @(SectorLayout.ImageOffsetY)px; width: @(SectorLayout.ImageWidth)px; height: @(SectorLayout.ImageHeight)px;">
                Board art missing — expected <code>reference/board/GameBoardMarkup.png</code>
            </div>
        }

        <svg class="map-overlay"
             xmlns="http://www.w3.org/2000/svg"
             width="@SectorLayout.BoardWidth"
             height="@SectorLayout.BoardHeight"
             viewBox="0 0 @SectorLayout.BoardWidth @SectorLayout.BoardHeight">
            @foreach (var sector in _layout.All)
            {
                var selected = string.Equals(SelectedSectorId, sector.SectorId, StringComparison.OrdinalIgnoreCase);
                var occupied = OccupiedSectorIds.Contains(sector.SectorId);
                var legal = LegalSet.Contains(sector.SectorId);
                var onPath = PathSet.Contains(sector.SectorId);
                var pathEnd = string.Equals(PathDestinationId, sector.SectorId, StringComparison.OrdinalIgnoreCase);
                <polygon @key="sector.SectorId"
                         class="sector-poly @(selected ? "is-selected" : null) @(occupied ? "is-occupied" : null) @(legal ? "is-legal" : null) @(onPath ? "is-path" : null) @(pathEnd ? "is-path-end" : null)"
                         points="@sector.PointsAttribute"
                         @onclick="() => OnSectorClick(sector.SectorId)"
                         @onclick:stopPropagation="true" />
            }

            @if (PathSectorIds.Count >= 2)
            {
                <polyline class="fly-path-line"
                          points="@PathPolylinePoints"
                          fill="none" />
            }

            @foreach (var placed in _placed)
            {
                var inv = CultureInfo.InvariantCulture;
                var tx = placed.X.ToString("0.###", inv);
                var ty = placed.Y.ToString("0.###", inv);
                var halfW = placed.DisplayWidth / 2;
                var halfH = placed.DisplayHeight / 2;
                <g @key="placed.Key"
                   class="@placed.CssClass"
                   transform="translate(@tx @ty)">
                    @if (placed.IsCurrent)
                    {
                        <circle class="token-halo" r="@(Math.Max(halfW, halfH) + 10)" />
                    }
                    @if (placed.AlertSprite is { } sprite)
                    {
                        @* Prefs / sprite atlas: crop IconSpriteSheet logos for Alliance / Reaver alert chits. *@
                        <svg x="@((-halfW).ToString("0.###", inv))"
                             y="@((-halfH).ToString("0.###", inv))"
                             width="@placed.DisplayWidth.ToString("0.###", inv)"
                             height="@placed.DisplayHeight.ToString("0.###", inv)"
                             viewBox="@sprite.ViewBox"
                             overflow="hidden">
                            <image href="@sprite.SheetHref"
                                   width="@sprite.SheetWidth.ToString(inv)"
                                   height="@sprite.SheetHeight.ToString(inv)"
                                   preserveAspectRatio="none" />
                        </svg>
                    }
                    else
                    {
                        <image href="@placed.IconSrc"
                               x="@((-halfW).ToString("0.###", inv))"
                               y="@((-halfH).ToString("0.###", inv))"
                               width="@placed.DisplayWidth.ToString("0.###", inv)"
                               height="@placed.DisplayHeight.ToString("0.###", inv)"
                               preserveAspectRatio="xMidYMid meet" />
                    }
                    <title>@placed.Title</title>
                </g>
            }
        </svg>
    </div>
</div>

@code {
    private const double ShipDisplayWidth = 96;
    private const double ShipDisplayHeight = 56;
    private const double MarkerDisplayWidth = 88;
    private const double MarkerDisplayHeight = 72;
    private const double CruiserDisplayWidth = 64;
    private const double CruiserDisplayHeight = 104;
    private const double AlertChitDisplayWidth = 36;
    private const double AlertChitDisplayHeight = 44;
    private const double StackRadius = 36;

    // docs/sprite-sheet-atlas.md — IconSpriteSheet.webp 2550×2316
    private static readonly AlertSpriteCrop AllianceAlertSprite = new(
        "/tokens/IconSpriteSheet.webp", 2550, 2316, "1812 172 300 368");
    private static readonly AlertSpriteCrop ReaverAlertSprite = new(
        "/tokens/IconSpriteSheet.webp", 2550, 2316, "2176 180 356 360");

    [Parameter] public string? SelectedSectorId { get; set; }
    [Parameter] public IReadOnlyList<ShipTokenView> Ships { get; set; } = Array.Empty<ShipTokenView>();
    [Parameter] public IReadOnlyList<MarkerTokenView> Markers { get; set; } = Array.Empty<MarkerTokenView>();
    [Parameter] public IReadOnlyList<string> LegalSectorIds { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> PathSectorIds { get; set; } = Array.Empty<string>();
    [Parameter] public string? PathDestinationId { get; set; }
    [Parameter] public bool BoardArtAvailable { get; set; }
    [Parameter] public EventCallback<string> SectorSelected { get; set; }

    private ElementReference _viewport;
    private ElementReference _stage;
    private SectorLayout _layout = new();
    private bool _boardAvailable;
    private HashSet<string> OccupiedSectorIds { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> LegalSet { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> PathSet { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private List<PlacedToken> _placed = new();
    private string PathPolylinePoints { get; set; } = "";
    private IJSObjectReference? _camera;

    protected override void OnParametersSet()
    {
        _layout = LayoutService.Layout;
        _boardAvailable = BoardArtAvailable;
        OccupiedSectorIds = Ships.Select(s => s.SectorId)
            .Concat(Markers.Select(m => m.SectorId))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        LegalSet = LegalSectorIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
        PathSet = PathSectorIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
        PathPolylinePoints = BuildPathPolyline();
        _placed = BuildPlacedTokens();
    }

    private string BuildPathPolyline()
    {
        if (PathSectorIds.Count < 2)
            return "";
        var inv = CultureInfo.InvariantCulture;
        var parts = new List<string>(PathSectorIds.Count);
        foreach (var id in PathSectorIds)
        {
            if (!_layout.ById.TryGetValue(id, out var geo))
                continue;
            parts.Add($"{geo.CentroidX.ToString("0.###", inv)},{geo.CentroidY.ToString("0.###", inv)}");
        }
        return string.Join(" ", parts);
    }

    private List<PlacedToken> BuildPlacedTokens()
    {
        var bySector = new Dictionary<string, List<PlacedToken>>(StringComparer.OrdinalIgnoreCase);

        void Add(string sectorId, PlacedToken token)
        {
            if (!bySector.TryGetValue(sectorId, out var list))
            {
                list = new List<PlacedToken>();
                bySector[sectorId] = list;
            }
            list.Add(token);
        }

        foreach (var ship in Ships)
        {
            if (!_layout.ById.TryGetValue(ship.SectorId, out var geo))
                continue;
            var css = "token ship" + (ship.IsCurrent ? " is-current" : "");
            Add(ship.SectorId, new PlacedToken(
                ship.PlayerId,
                ship.SectorId,
                geo.CentroidX,
                geo.CentroidY,
                ShipDisplayWidth,
                ShipDisplayHeight,
                ship.IconSrc,
                css,
                $"{ship.Name} · {ship.ShipId} · {ship.SectorId}",
                ship.IsCurrent));
        }

        foreach (var marker in Markers)
        {
            if (!_layout.ById.TryGetValue(marker.SectorId, out var geo))
                continue;
            var (w, h) = marker.Kind switch
            {
                MarkerKind.AllianceCruiser => (CruiserDisplayWidth, CruiserDisplayHeight),
                MarkerKind.AllianceAlertChit or MarkerKind.ReaverAlertChit =>
                    (AlertChitDisplayWidth, AlertChitDisplayHeight),
                _ => (MarkerDisplayWidth, MarkerDisplayHeight)
            };
            var css = marker.Kind switch
            {
                MarkerKind.AllianceCruiser => "token marker cruiser",
                MarkerKind.ReaverCutter => "token marker cutter",
                MarkerKind.Corvette => "token marker corvette",
                MarkerKind.AllianceAlertChit => "token marker alert-chit alliance",
                MarkerKind.ReaverAlertChit => "token marker alert-chit reaver",
                _ => "token marker"
            };
            AlertSpriteCrop? sprite = marker.Kind switch
            {
                MarkerKind.AllianceAlertChit => AllianceAlertSprite,
                MarkerKind.ReaverAlertChit => ReaverAlertSprite,
                _ => null
            };
            Add(marker.SectorId, new PlacedToken(
                marker.Id,
                marker.SectorId,
                geo.CentroidX,
                geo.CentroidY,
                w,
                h,
                marker.IconSrc,
                css,
                $"{marker.Label} · {marker.SectorId}",
                IsCurrent: false,
                sprite));
        }

        var result = new List<PlacedToken>();
        foreach (var group in bySector.Values)
        {
            var count = group.Count;
            for (var i = 0; i < count; i++)
            {
                var (dx, dy) = StackOffset(i, count);
                var t = group[i];
                result.Add(t with { X = t.X + dx, Y = t.Y + dy });
            }
        }

        return result;
    }

    /// <summary>Slight ring offset when multiple ships/NPCs share a sector so icons do not stack perfectly.</summary>
    private static (double Dx, double Dy) StackOffset(int index, int count)
    {
        if (count <= 1)
            return (0, 0);
        var angle = (Math.PI * 2 * index / count) - (Math.PI / 2);
        return (Math.Cos(angle) * StackRadius, Math.Sin(angle) * StackRadius);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _camera != null)
            return;
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/map-camera.js");
            _camera = await module.InvokeAsync<IJSObjectReference>("attach", _viewport, _stage);
            await module.DisposeAsync();
        }
        catch (JSException)
        {
            // Camera is progressive enhancement; map still clickable without it.
        }
    }

    private async Task OnSectorClick(string sectorId)
    {
        await SectorSelected.InvokeAsync(sectorId);
    }

    public async ValueTask DisposeAsync()
    {
        if (_camera is not null)
        {
            try
            {
                await _camera.InvokeVoidAsync("dispose");
                await _camera.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private sealed record AlertSpriteCrop(
        string SheetHref,
        int SheetWidth,
        int SheetHeight,
        string ViewBox);

    private sealed record PlacedToken(
        string Key,
        string SectorId,
        double X,
        double Y,
        double DisplayWidth,
        double DisplayHeight,
        string IconSrc,
        string CssClass,
        string Title,
        bool IsCurrent,
        AlertSpriteCrop? AlertSprite = null);
}
